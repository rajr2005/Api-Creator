{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-creator.onrender.com/api/:path*"
    },
    {
      "source": "/mock/:path*",
      "destination": "https://api-creator.onrender.com/mock/:path*"
    }
  ]
}
